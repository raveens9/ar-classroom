# Web (apps/web)
NEXT_PUBLIC_REALTIME_URL=https://localhost:4002
NEXT_PUBLIC_ML_API_URL=https://localhost:8000

# Realtime (apps/realtime)
REALTIME_PORT=4002
FRONTEND_ORIGIN=https://localhost:3000
ALLOW_ALL_ORIGINS=true

# TLS (shared across node services)
TLS_ENABLED=true
TLS_KEY_PATH=../../certs/dev-key.pem
TLS_CERT_PATH=../../certs/dev-cert.pem

# ML API (apps/ml-api)
ML_API_PUBLIC_BASE_URL=https://localhost:8000
MODEL_ASSET_BASE_URL=https://localhost:8000/static
