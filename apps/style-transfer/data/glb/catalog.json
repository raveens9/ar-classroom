{
  "_comment": "Maps classifier class names to canonical .glb paths (relative to data/glb/). Also records material type and whether the model has animations — both affect the style-transfer code path.",
  "_material_types": {
    "TEXTURED": "PBR metallic-roughness with embedded texture image — main code path",
    "FLAT":     "PBR metallic-roughness with baseColorFactor only, no texture image",
    "MIXED":    "Some materials textured, some flat — both code paths needed",
    "KHR_SPEC": "Legacy KHR_materials_pbrSpecularGlossiness extension — needs diffuseTexture extraction"
  },

