ML_API_PORT=8000
ML_API_PUBLIC_BASE_URL=https://localhost:8000
MODEL_ASSET_BASE_URL=https://localhost:8000/static
# Base URL for .glb files served by the web app (apps/web/public/). On LAN the
# web client's rewriteHost() swaps "localhost" → the phone's current hostname.
WEB_PUBLIC_BASE_URL=https://localhost:3000
TLS_ENABLED=true
TLS_KEY_PATH=../../certs/dev-key.pem
TLS_CERT_PATH=../../certs/dev-cert.pem
